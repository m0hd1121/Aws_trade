# Copy to .env and fill in. Never commit the real .env file.

# --- MetaTrader 5 API credentials (demo or live account) ---
# The bot connects via the official `MetaTrader5` python package, which
# talks directly to the broker's trade server through the locally
# installed terminal's IPC channel. No manual desktop-terminal trading is
# used or required for order placement.
MT5_LOGIN=00000000
MT5_PASSWORD=change-me
MT5_SERVER=YourBroker-Demo
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT_MS=10000

# --- App ---
DATABASE_URL=sqlite:///./data/m5_bot.db
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=./logs
