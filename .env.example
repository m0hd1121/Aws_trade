# Copy to .env and fill in. Never commit the real .env file.

# --- MetaTrader 5 API credentials (demo or live account) ---
# Login/password/server can also be set (or changed) live from the
# dashboard's Broker Connection panel — POST /api/bot/broker-connect —
# without editing this file or restarting. Values here are just the
# startup defaults.
MT5_LOGIN=00000000
MT5_PASSWORD=change-me
MT5_SERVER=YourBroker-Demo

# bridge_mode=local: the real MetaTrader5 package on THIS host (Windows,
#   or Wine on this same Linux box). Uses MT5_TERMINAL_PATH below.
# bridge_mode=mt5linux: talk to a remote MT5 terminal (a Dockerized Wine
#   container) over the mt5linux bridge instead — no Wine on this host at
#   all. See docker/docker-compose.mt5-bridge.yml and docs/DEPLOYMENT.md.
MT5_BRIDGE_MODE=local
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8001
# Seconds to allow for one call to the bridge. RPyC's own default is 30s,
# which is too tight: mt5linux's first action after connecting is
# `import MetaTrader5` on the Wine side, and that is slow on a small VPS.
# Too low shows up as "TimeoutError: result expired", which says nothing
# about MT5.
MT5_BRIDGE_REQUEST_TIMEOUT=300
# Windows-side path to terminal64.exe AS WINE SEES IT INSIDE THE BRIDGE
# CONTAINER — not a path on this host. Only change this if you rebuilt
# docker/mt5-bridge/ to install somewhere other than its default location;
# the default below matches that entrypoint.sh exactly.
MT5_BRIDGE_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT_MS=10000

# --- Dashboard network exposure ---
# Which host interface publishes the dashboard.
#   0.0.0.0   = reachable from the internet. Only do this with
#               DASHBOARD_USERNAME/PASSWORD set below, plus a firewall.
#   127.0.0.1 = reachable only from the VPS itself; get to it with
#               ssh -N -L 8000:localhost:8000 root@your-vps
#               then open http://localhost:8000 on your own machine.
#               No open port, no shared password, no third party.
DASHBOARD_BIND=0.0.0.0

# --- Cloudflare Tunnel (optional; ./setup.sh --tunnel) ---
# When set, the dashboard is reached over a Cloudflare Tunnel and NO port
# is published on this host at all. Get the token from the Cloudflare Zero
# Trust dashboard: Networks -> Tunnels -> Create a tunnel -> Cloudflared.
# Full walkthrough in docker/docker-compose.cloudflared.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Dashboard auth (optional but recommended once you enter real
# credentials via the Broker Connection panel) ---
# Leave both blank to run with no auth (fine behind your own VPN/reverse
# proxy). Set both to require HTTP Basic Auth on the whole app.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Unattended operation ---
# The bot normally comes up IDLE after a restart and waits for you to press
# Start Bot in the dashboard, so an unexpected reboot never silently resumes
# trading. Set to 1 if you want it to start trading automatically whenever
# the container starts — needed for genuine 24/7 running with nobody
# watching, but it does mean a restart resumes live trading unattended.
M5BOT_AUTOSTART=0

# --- App ---
DATABASE_URL=sqlite:///./data/m5_bot.db
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=./logs
